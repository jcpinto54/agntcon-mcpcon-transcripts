{
  "name": "agntcon-mcpcon-archive-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Search over the AGNTCon + MCPCon Europe 2026 transcript archive, served as a stateless MCP server and a plain HTTP API.",
  "scripts": {
    "build": "node scripts/build_index.ts",
    "predev": "npm run build",
    "dev": "wrangler dev",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "pretypecheck": "npm run build",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
