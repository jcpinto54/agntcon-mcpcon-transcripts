# Audio recordings are never committed — they stay local.
# Speakers own their talks; this repo publishes transcripts only.
*.m4a
*.wav
*.mp3
*.aac
*.flac
*.mp4
*.mov

# Local staging area for raw recordings
recordings/

# Transcription working files
.transcribe-cache/

# macOS
.DS_Store

# Local editor state (Obsidian vault config)
.obsidian/

# Git worktrees created by parallel agent sessions
.claude/worktrees/

# Python bytecode from the skill scripts
__pycache__/

# Slide decks pulled from the organisers' Sched pages: 161 MB across 51
# sessions, against a repo that is otherwise ~1 MB. The extracted text IS
# committed, and every materials.md links the organisers' hosted copy, so
# nothing breaks without them. Provisional — delete these two lines to commit
# the decks themselves.
talks/*/materials/*.pdf
talks/*/materials/*.pptx
