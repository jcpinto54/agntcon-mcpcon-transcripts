.transcribe-cache/

# macOS
.DS_Store

# Local editor state (Obsidian vault config)
.obsidian/

# Git worktrees created by parallel agent sessions
.claude/worktrees/

# Python bytecode from the skill scripts
__pycache__/

# Slide decks are committed, but through Git LFS (see .gitattributes) so a
# plain clone stays small. Run `git lfs pull` to fetch the files themselves.
