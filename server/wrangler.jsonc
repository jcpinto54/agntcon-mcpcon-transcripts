{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntcon-mcpcon-archive",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Logs for every request; the archive is public and read-only, so there is
  // nothing sensitive to sample away. Traces are left off — the free plan has
  // no budget to spend on them.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
  // No bindings: the prebuilt index (data/index.ts, generated by
  // `npm run build`) is bundled into the Worker and parsed once at start-up,
  // which has a 1 s budget — a request on the free plan has 10 ms of CPU, so
  // nothing is parsed per request.
}
